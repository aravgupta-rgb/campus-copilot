{
  "name": "campus-copilot-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_SKIN=bold VITE_PALETTE=default vite",
    "build": "VITE_SKIN=${VITE_SKIN:-bold} VITE_PALETTE=${VITE_PALETTE:-default} vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:aurora": "VITE_SKIN=aurora VITE_PALETTE=default vite --port 5174 --strictPort",
    "dev:navy": "VITE_SKIN=bold VITE_PALETTE=navy vite --port 5175 --strictPort"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "vite": "^6.3.5"
  }
}
