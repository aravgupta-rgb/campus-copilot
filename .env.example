# Copy this file to .env and fill in real values. Never commit .env.

# Gemini (Google AI Studio key, shared privately by Aaryav)
GEMINI_API_KEY=
# TRUE = Gemini through Vertex AI on our Google Cloud credits (needs gcloud login, see README).
# FALSE = AI Studio key above (free tier, ~20 requests/day per model). Use as fallback.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Google Cloud
GOOGLE_CLOUD_PROJECT=campus-copilot-514718
GOOGLE_CLOUD_LOCATION=global

# Firebase web app config (frontend, from Firebase console > Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Where the frontend sends requests (localhost now, the Cloud Run URL later)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Model. Free tier is about 20 requests/day per model; switch if you hit 429.
GEMINI_MODEL=gemini-3.5-flash

# Voice mode (adk web phone/camera buttons). Live models need a region, not global.
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_LIVE_LOCATION=us-central1
